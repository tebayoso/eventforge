{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eventforge-console",
  "account_id": "b9f5ebc6c05975fab56f056782461b77",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"],
  },
  "routes": [
    {
      "pattern": "eventforge.dev",
      "custom_domain": true,
    },
  ],
  // Same-origin /api proxy so the session cookie can stay SameSite=Strict.
  "vars": {
    "API_ORIGIN": "https://api.eventforge.dev",
  },
}
